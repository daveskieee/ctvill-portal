datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ENGINEER
  TIMEKEEPER
  FINANCE
  INSPECTOR
  CLIENT
  PROJECT_MANAGER
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  UNDER_CONTRACT
  DEVELOPING
  TITLING_PHASE
  TURNOVER_READY
  HANDED_OVER
  SOLD
}

enum PaymentMethod {
  INSTALLMENT
  SPOT_CASH
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String
  role              Role          @default(CLIENT)
  accountStatus     AccountStatus @default(ACTIVE)
  passwordHash      String?
  inviteToken       String?
  inviteTokenExpiry DateTime?
  contact           String?
  projectIds        String[]      @default([]) @map("project_ids")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relationships
  clientPackage        ClientPackage?      // One-to-one mapping for client package details
  weeklyProgressLogs   WeeklyProgressLog[] // Inspector logs created by this user
  inspectedDefects     PunchListDefect[]   // Defects reported by inspector
  buyerKyc             BuyerKyc?           // KYC verification checklist
  loggedAttendanceLogs AttendanceLog[]     @relation("LoggedAttendance")
  approvedPayrollRuns  PayrollRun[]        @relation("ApprovedPayrolls")

  @@index([inviteToken])
  @@map("users")
}

model LandParcel {
  id              String   @id @default(uuid())
  name            String   // e.g., "Cavinti Highland Crest"
  location        String
  purchaseCost    Decimal  @db.Decimal(12, 2)
  totalAreaSqm    Float
  totalSlots      Int      // subdividedSlotsCount
  acquisitionDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  slots                Slot[]
  civilWorksMilestones CivilWorksMilestone[]

  @@map("land_parcels")
}

model Slot {
  id           String     @id @default(uuid())
  parcelId     String
  slotNumber   Int
  sizeSqm      Float      // areaSqm
  price        Decimal    @db.Decimal(12, 2) // basePrice
  status       SlotStatus @default(AVAILABLE)
  row          Int        // Grid Row coordinate for frontend visualization
  col          Int        // Grid Column coordinate for frontend visualization
  polygonPoints String?   @db.Text // JSON string of [{x,y}, ...] vertices from AutoCAD
  blockName    String?    // e.g., "Block 1", "Block 2", "Sector A"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  landParcel         LandParcel          @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  weeklyProgressLogs WeeklyProgressLog[]
  clientPackage      ClientPackage?      // One-to-one mapping to client purchase package
  defects            PunchListDefect[]

  @@unique([parcelId, slotNumber]) // Enforce unique slot number per land parcel
  @@map("slots")
}

model Contractor {
  id                String   @id @default(uuid())
  name              String
  contact           String?
  activeProjectSite String?  @map("active_project_site")
  assignedZone      String?  @map("assigned_zone")
  company           String?  @default("CTVill Builders Corporation")
  specialty         String?  // e.g., "Land Leveling", "Road Construction", or Trade
  employmentType    String   @default("INTERNAL") // "INTERNAL" (CTVill Staff/Crew) or "OUTSOURCED" (Partner Firm)
  department        String?  // e.g. "Project Management & Construction", "Design & Pre-Construction", etc.
  roleTitle         String?  // e.g. "Site Foremen", "Lead Architect", etc.
  dailyRate         Decimal? @db.Decimal(10, 2)
  monthlySalary     Decimal? @db.Decimal(12, 2)
  status            String   @default("ACTIVE") // "ACTIVE", "ON_LEAVE", "INACTIVE"
  contractAmount    Decimal? @db.Decimal(12, 2)
  paidAmount        Decimal? @db.Decimal(12, 2)
  activeManpower    Int      @default(1)
  milestoneProgress Float    @default(0.0) // percentage
  rating            Float?   @default(5.0) // scale of 1-5
  workforceCategory String?  @default("SKILLED")
  allocationStatus  String?  @default("ASSIGNED")
  avatar            String?  @map("avatar")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  assignedDefects   PunchListDefect[]
  tasks             ProjectTask[]

  @@map("contractors")
}

model WeeklyProgressLog {
  id                 String   @id @default(uuid())
  slotId             String
  inspectorId        String
  date               DateTime @default(now())
  percentageComplete Float    @default(0.0)
  materialsUsed      String   @db.Text
  manpowerHeadcount  Int      @default(0)
  notes              String   @db.Text
  complianceStatus   String?  // e.g., "Compliant", "Corrective Action Required"
  structuralCheck    String?  // e.g., "Pass", "Fail"
  safetyCheck        String?  // e.g., "Pass", "Fail"
  siteActivity       String?  // e.g., "Road Subgrade", "Leveling"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  slot      Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  inspector User @relation(fields: [inspectorId], references: [id])

  @@map("weekly_progress_logs")
}

model PunchListDefect {
  id              String   @id @default(uuid())
  slotId          String
  inspectorId     String
  contractorId    String?
  title           String
  description     String   @db.Text
  severity        String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status          String   @default("OPEN")   // "OPEN", "CONTRACTOR_RECTIFIED", "RE_INSPECTED", "CLOSED"
  category        String   @default("ROADS")  // "ROADS", "DRAINAGE", "GRADING", "BOUNDARY", "UTILITIES"
  resolutionNotes String?  @db.Text
  targetDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  slot       Slot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  inspector  User        @relation(fields: [inspectorId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])

  @@map("punch_list_defects")
}

model CivilWorksMilestone {
  id                String   @id @default(uuid())
  parcelId          String
  phaseName         String   // "Phase A: Land Clearing & Grading", etc.
  targetPercentage  Float    @default(100.0)
  currentPercentage Float    @default(0.0)
  status            String   @default("IN_PROGRESS") // "NOT_STARTED", "IN_PROGRESS", "INSPECTION_PENDING", "COMPLETED"
  inspectorSignOff  Boolean  @default(false)
  signOffDate       DateTime?
  remarks           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  landParcel LandParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@map("civil_works_milestones")
}

model DailyManpowerAudit {
  id                    String   @id @default(uuid())
  date                  DateTime @default(now())
  contractorId          String
  contractorName        String
  specialty             String
  shift                 String   @default("Morning") // "Morning", "Afternoon", "Full Day"
  claimedHeadcount      Int      @default(0)
  verifiedHeadcount     Int      @default(0)
  discrepancy           Int      @default(0)
  assignedSectorOrLot   String
  supervisorName        String
  gpsCoordinates        String
  verificationStatus    String   @default("VERIFIED_MATCH") // "VERIFIED_MATCH", "DISCREPANCY_FLAGGED", "RESOLVED"
  photoEvidenceVerified Boolean  @default(true)
  remarks               String   @db.Text
  productivityIndex     Float    @default(90.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("daily_manpower_audits")
}


model BuyerKyc {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  govtIdVerified         Boolean   @default(false)
  tinVerified            Boolean   @default(false)
  proofOfIncomeVerified  Boolean   @default(false)
  proofOfAddressVerified Boolean   @default(false)
  maritalConsentVerified Boolean   @default(false)
  kycStatus              String    @default("PENDING") // "PENDING", "UNDER_REVIEW", "VERIFIED"
  verifiedAt             DateTime?
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_kyc")
}

model ClientPackage {
  id            String        @id @default(uuid())
  userId        String        @unique // Role.CLIENT User
  slotId        String?       @unique // Selected Slot (Optional if unassigned)
  price         Decimal       @db.Decimal(12, 2) // totalContractPrice
  packageType   String        // e.g., "Standard Package (Land + Road Dev)"
  paymentMethod PaymentMethod @default(INSTALLMENT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot                Slot?                @relation(fields: [slotId], references: [id], onDelete: SetNull)
  installmentLedgers  InstallmentLedger[]
  titlePermitTracker  TitlePermitTracker?

  @@map("client_packages")
}

model InstallmentLedger {
  id              String        @id @default(uuid())
  clientPackageId String
  dueDate         DateTime
  amountDue       Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal?      @db.Decimal(12, 2)
  paymentDate     DateTime?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  clientPackage ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)

  @@map("installment_ledgers")
}

model TitlePermitTracker {
  id                             String   @id @default(uuid())
  clientPackageId                String   @unique
  currentPhase                   String   // e.g., "LGU Development Permit", "BIR eCAR", "Registry of Deeds TCT"
  motherTitleVerified            Boolean  @default(true)
  darClearanceApproved           Boolean  @default(true)
  lguPermitIssued                Boolean  @default(false)
  dhsudLicenseToSell             Boolean  @default(false)
  legalPermitsApproved           Boolean  @default(false)
  ctsSigned                      Boolean  @default(false)
  deedOfSaleSigned               Boolean  @default(false)
  birEcarIssued                  Boolean  @default(false)
  taxDeclarationTransferred      Boolean  @default(false)
  landTitleReleased              Boolean  @default(false)
  registryOfDeedsTctReleased     Boolean  @default(false)
  certificateOfAcceptanceSigned  Boolean  @default(false)
  tctNumber                      String?  // e.g., "TCT-2026-089421"
  taxDecNumber                   String?  // e.g., "TD-2026-CVNT-9982"
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  // Relationships
  clientPackage ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)

  @@map("title_permit_trackers")
}

model ProcessAuditLog {
  id         String   @id @default(uuid())
  entityType String   // "SLOT", "CLIENT", "TITLING", "DEFECT", "CIVIL_WORKS", "TURNOVER"
  entityId   String
  action     String   // e.g., "SLOT_TRANSITION", "TITLING_MILESTONE_UPDATED", "DEFECT_RECTIFIED"
  actorName  String
  actorRole  String
  details    String   @db.Text
  createdAt  DateTime @default(now())

  @@map("process_audit_logs")
}

enum PayrollRole {
  INTERNAL_STAFF
  SITE_MONITOR
  CONTRACTOR
}

enum DisbursementType {
  SALARY
  CONTRACT_MILESTONE
}

enum PayrollStatus {
  DISBURSED
  PENDING
}

model PayrollRecord {
  id               String           @id @default(uuid())
  date             DateTime         @default(now())
  payeeName        String
  role             PayrollRole
  disbursementType DisbursementType
  amount           Decimal          @db.Decimal(12, 2)
  status           PayrollStatus    @default(PENDING)
  paymentMethod    String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("payroll_records")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

model CommercialProject {
  id                         String        @id @default(uuid())
  name                       String
  clientName                 String        @map("client_name")
  description                String?       @db.Text
  location                   String?
  budget                     Decimal?      @default(0)
  fundsCollected             Decimal?      @default(0) @map("funds_collected")
  progressPercentage         Decimal?      @default(0) @map("progress_percentage")
  status                     String?       @default("IN_PROGRESS")
  targetHandoverDate         DateTime?     @map("target_handover_date")
  startDate                  DateTime?     @map("start_date")
  assignedWorkersCount       Int?          @default(0) @map("assigned_workers_count")
  tasksCount                 Int?          @default(0) @map("tasks_count")
  milestonesCount            Int?          @default(0) @map("milestones_count")
  isPrivateAccounting        Boolean       @default(false) @map("is_private_accounting")
  assignedProjectManagerId   String?       @map("assigned_project_manager_id")
  assignedProjectManagerName String?       @map("assigned_project_manager_name")
  latitude                   Decimal?
  longitude                  Decimal?
  weatherSuspended           Boolean       @default(false) @map("weather_suspended")
  createdAt                  DateTime?     @default(now()) @map("created_at")

  // Relationships
  tasks                      ProjectTask[]
  workerAssignments          ProjectWorkerAssignment[]
  attendanceLogs             AttendanceLog[]
  cashAdvances               CashAdvance[]
  payrollRuns                PayrollRun[]

  @@map("commercial_projects")
}

model ProjectTask {
  id                    String            @id @default(uuid())
  projectId             String
  project               CommercialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsCode               String?
  text                  String
  title                 String?
  description           String?
  assigneeName          String?
  assigneeRole          String?
  priority              TaskPriority?     @default(MEDIUM)
  status                TaskStatus?       @default(TODO)
  category              String?
  milestonePhase        String?
  subtasksJson          String?
  tags                  String?
  dueDate               DateTime?
  startDate             DateTime
  endDate               DateTime
  duration              Int
  progress              Float             @default(0.0)
  baselineStart         DateTime?
  baselineEnd           DateTime?
  type                  String            @default("task")
  parentTaskId          String?
  sortOrder             Int               @default(0)
  assignedContractorId  String?
  assignedContractor    Contractor?       @relation(fields: [assignedContractorId], references: [id])
  targetLinks           TaskLink[]        @relation("TargetTasks")
  sourceLinks           TaskLink[]        @relation("SourceTasks")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("project_tasks")
}

model TaskLink {
  id          String      @id @default(uuid())
  projectId   String
  sourceId    String
  sourceTask  ProjectTask @relation("SourceTasks", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  targetTask  ProjectTask @relation("TargetTasks", fields: [targetId], references: [id], onDelete: Cascade)
  type        String      @default("0")
  lagDays     Int         @default(0)

  @@map("task_links")
}

model DailySiteLog {
  id               String   @id @default(uuid())
  date             DateTime @default(now())
  weather          String   // "SUNNY", "OVERCAST", "RAINY", "STORM"
  temperature      String?  // e.g., "31°C"
  activeHeadcount  Int      @default(0)
  equipmentOnSite  String?  @db.Text // e.g., "1x Cat Excavator, 1x Road Roller, 2x Dump Trucks"
  toolboxTopic     String?  // Safety meeting topic
  workCompleted    String   @db.Text
  delaysOrIssues   String?  @db.Text
  supervisorName   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("daily_site_logs")
}

model ProjectDocument {
  id           String   @id @default(uuid())
  title        String
  category     String   // "CAD_DRAWING", "PERMIT_DHSUD", "LGU_CLEARANCE", "STRUCTURAL_PLAN", "DEED_LEGAL"
  fileUrl      String?  @db.Text
  fileSize     String?
  version      String   @default("1.0")
  status       String   @default("APPROVED") // "APPROVED", "UNDER_REVIEW", "DRAFT", "ARCHIVED"
  uploadedBy   String
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("project_documents")
}

model ProjectRisk {
  id             String   @id @default(uuid())
  title          String
  category       String   // "WEATHER", "REGULATORY", "SUPPLY_CHAIN", "TECHNICAL", "FINANCIAL"
  likelihood     Int      @default(3) // 1-5
  impact         Int      @default(3) // 1-5
  riskScore      Int      @default(9) // likelihood * impact
  mitigationPlan String   @db.Text
  status         String   @default("OPEN") // "OPEN", "MITIGATING", "RESOLVED"
  ownerName      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("project_risks")
}

model ChangeOrder {
  id              String   @id @default(uuid())
  orderNumber     String   @unique // e.g., "CO-2026-001"
  title           String
  contractorName  String
  requestedAmount Decimal  @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)
  status          String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  justification   String   @db.Text
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("change_orders")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model WeatherCache {
  siteKey     String   @id @map("site_key")
  weatherData Json     @map("weather_data")
  cachedAt    DateTime @default(now()) @map("cached_at")

  @@map("weather_cache")
}

model ExtendedPayroll {
  id                String    @id @default(uuid())
  workerName        String    @map("worker_name")
  contractorCompany String    @map("contractor_company")
  projectName       String    @map("project_name")
  role              String
  hoursWorked       Decimal?  @default(0) @map("hours_worked")
  daysWorked        Decimal?  @default(0) @map("days_worked")
  dailyRate         Decimal?  @default(0) @map("daily_rate")
  overtimeHours     Decimal?  @default(0) @map("overtime_hours")
  grossPay          Decimal?  @default(0) @map("gross_pay")
  deductions        Decimal?  @default(0)
  netPay            Decimal?  @default(0) @map("net_pay")
  status            String?   @default("Pending")
  disbursementDate  DateTime? @map("disbursement_date")
  paymentMethod     String?   @default("Bank Transfer") @map("payment_method")
  createdAt         DateTime? @default(now()) @map("created_at")

  @@map("extended_payroll")
}

model GovernmentPermit {
  id              String    @id @default(uuid())
  projectId       String?   @map("project_id")
  projectName     String    @map("project_name")
  permitName      String    @map("permit_name")
  permitType      String    @map("permit_type")
  issuingAgency   String    @map("issuing_agency")
  referenceNo     String?   @map("reference_no")
  status          String?   @default("PENDING")
  applicationDate DateTime? @map("application_date")
  approvalDate    DateTime? @map("approval_date")
  expiryDate      DateTime? @map("expiry_date")
  notes           String?   @db.Text
  documentUrl     String?   @map("document_url")
  createdAt       DateTime? @default(now()) @map("created_at")

  @@map("government_permits")
}

model ScheduleEvent {
  id          String    @id @default(uuid())
  projectId   String?   @map("project_id")
  projectName String?   @map("project_name")
  title       String
  eventType   String?   @default("MEETING") @map("event_type")
  eventDate   DateTime  @map("event_date")
  startTime   String?   @map("start_time")
  endTime     String?   @map("end_time")
  location    String?
  attendees   String?
  notes       String?   @db.Text
  status      String?   @default("SCHEDULED")
  createdAt   DateTime? @default(now()) @map("created_at")

  @@map("schedule_events")
}

model LaborAllocation {
  id                String    @id @default(uuid())
  contractorId      String    @map("contractor_id")
  contractorName    String    @map("contractor_name")
  sectorName        String    @map("sector_name")
  targetLots        String    @map("target_lots")
  assignedHeadcount Int?      @default(0) @map("assigned_headcount")
  workScope         String    @map("work_scope")
  status            String?   @default("ACTIVE")
  notes             String?   @db.Text
  updatedAt         DateTime? @default(now()) @map("updated_at")
  createdAt         DateTime? @default(now()) @map("created_at")

  @@map("labor_allocations")
}

model AIManpowerRecommendation {
  id                   String    @id @default(uuid())
  title                String
  targetLots           String    @map("target_lots")
  contractorId         String    @map("contractor_id")
  contractorName       String    @map("contractor_name")
  currentHeadcount     Int       @map("current_headcount")
  recommendedHeadcount Int       @map("recommended_headcount")
  rationale            String    @db.Text
  priority             String?   @default("MEDIUM")
  applied              Boolean?  @default(false)
  createdAt            DateTime? @default(now()) @map("created_at")

  @@map("ai_manpower_recommendations")
}

model FitoutQuotation {
  id             String    @id @default(uuid())
  clientName     String    @map("client_name")
  clientEmail    String    @map("client_email")
  clientPhone    String?   @map("client_phone")
  projectScope   String    @map("project_scope")
  estimatedCost  Decimal?  @default(0) @map("estimated_cost")
  estimatedWeeks Decimal?  @default(0) @map("estimated_weeks")
  estimatorArea  Decimal?  @default(0) @map("estimator_area")
  spaceType      String?   @map("space_type")
  finishTier     String?   @map("finish_tier")
  projectNotes   String?   @db.Text @map("project_notes")
  status         String?   @default("PENDING")
  createdAt      DateTime? @default(now()) @map("created_at")

  @@map("fitout_quotations")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

enum CashAdvanceStatus {
  PENDING
  DEDUCTED
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PAID
}

model Worker {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  dailyRate    Decimal  @map("daily_rate") @db.Decimal(10, 2)
  hourlyOtRate Decimal  @map("hourly_ot_rate") @db.Decimal(10, 2)
  position     String   // e.g., Foreman, Skilled, Laborer
  status       String   @default("Active") // Active, Inactive
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignments    ProjectWorkerAssignment[]
  attendanceLogs AttendanceLog[]
  cashAdvances   CashAdvance[]
  payrollItems   PayrollItem[]

  @@map("workers")
}

model ProjectWorkerAssignment {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  workerId   String   @map("worker_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  status     String   @default("ACTIVE")

  project CommercialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker  Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([projectId, workerId])
  @@map("project_worker_assignments")
}

model AttendanceLog {
  id             String           @id @default(uuid())
  projectId      String           @map("project_id")
  workerId       String           @map("worker_id")
  loggedByUserId String           @map("logged_by_user_id")
  date           DateTime         @db.Date
  status         AttendanceStatus
  overtimeHours  Float            @default(0) @map("overtime_hours")
  isLocked       Boolean          @default(false) @map("is_locked")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  project  CommercialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker   Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  loggedBy User              @relation("LoggedAttendance", fields: [loggedByUserId], references: [id])

  @@unique([projectId, workerId, date])
  @@map("attendance_logs")
}

model CashAdvance {
  id                  String            @id @default(uuid())
  projectId           String            @map("project_id")
  workerId            String            @map("worker_id")
  amount              Decimal           @db.Decimal(10, 2)
  dateIssued          DateTime          @default(now()) @map("date_issued")
  deductedInPayrollId String?           @map("deducted_in_payroll_id")
  status              CashAdvanceStatus @default(PENDING)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")

  project           CommercialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker            Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  deductedInPayroll PayrollRun?       @relation(fields: [deductedInPayrollId], references: [id], onDelete: SetNull)

  @@map("cash_advances")
}

model PayrollRun {
  id               String           @id @default(uuid())
  projectId        String           @map("project_id")
  periodStart      DateTime         @map("period_start") @db.Date
  periodEnd        DateTime         @map("period_end") @db.Date
  status           PayrollRunStatus @default(DRAFT)
  totalGross       Decimal          @default(0) @map("total_gross") @db.Decimal(12, 2)
  totalDeductions  Decimal          @default(0) @map("total_deductions") @db.Decimal(12, 2)
  totalNet         Decimal          @default(0) @map("total_net") @db.Decimal(12, 2)
  approvedByUserId String?          @map("approved_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  project      CommercialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy   User?             @relation("ApprovedPayrolls", fields: [approvedByUserId], references: [id])
  items        PayrollItem[]
  cashAdvances CashAdvance[]

  @@map("payroll_runs")
}

model PayrollItem {
  id              String   @id @default(uuid())
  payrollRunId    String   @map("payroll_run_id")
  workerId        String   @map("worker_id")
  daysWorked      Float    @map("days_worked")
  otHours         Float    @default(0) @map("ot_hours")
  grossPay        Decimal  @map("gross_pay") @db.Decimal(10, 2)
  totalDeductions Decimal  @default(0) @map("total_deductions") @db.Decimal(10, 2)
  netPay          Decimal  @map("net_pay") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  worker     Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, workerId])
  @@map("payroll_items")
}

