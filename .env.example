# GEMINI_API_KEY: Required for Primary Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Secondary Groq AI failover (model: openai/gpt-oss-20b)
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cryptographic Session & CSRF Secrets (Minimum 32 characters required in production)
SESSION_SECRET="GENERATE_A_STRONG_RANDOM_HEX_SECRET_AT_LEAST_32_CHARS"
CSRF_SECRET="GENERATE_A_STRONG_RANDOM_HEX_SECRET_AT_LEAST_32_CHARS"
